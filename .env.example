# =======================================================
# 悦己颜值社 — 后端环境变量模板
# 复制为 .env 后填写真实值（.env 已在 .gitignore 中，不会被提交）
# =======================================================

# ---------- 数据库 ----------
# MySQL 连接（本地开发可用 Docker: docker run -e MYSQL_ROOT_PASSWORD=xxx mysql:8）
DATABASE_URL="mysql://root:password@localhost:3306/yueji_beauty"

# ---------- 认证 ----------
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---------- 文件存储 ----------
# 本地开发用本地目录；生产换 COS/OSS/S3
UPLOAD_DIR="./uploads"
FILE_BASE_URL="http://localhost:8080"

# ---------- AI 服务（未配置时返回 mock 数据，UI 可正常演示） ----------
# 腾讯云人脸分析（iai v20200303）
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_REGION="ap-shanghai"

# 通义千问（文案生成）
QWEN_API_KEY=""

# ---------- 微信支付 V2 启用 ----------
WECHAT_MCH_ID=""
WECHAT_APPID=""
WECHAT_API_V3_KEY=""
WECHAT_CERT_SERIAL_NO=""
# 微信支付回调（必须 HTTPS + 真实服务器域名，不能是 GitHub Pages）
WECHAT_NOTIFY_URL="https://your-domain.com/api/v1/payment/wechat/notify"

# ---------- 微信小程序 V1 静默登录 ----------
WX_MINI_APPID=""
WX_MINI_SECRET=""

# ---------- 前端 API 基址 ----------
# 前端请求时会用到（生产环境填真实域名）
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080"
