# =======================================================
# 悦己颜值社 — Next.js 后端环境变量模板
# =======================================================
# 使用方法：
#   1. 复制本文件为 .env  (已在 .gitignore，不会被提交)
#   2. 填写真实值。未配置的 AI/支付变量会走 mock 降级，UI 可正常演示
#   3. 本地开发：npm run dev → http://localhost:3000
#
# 代码引用位置：src/ 下 grep process.env. 可快速定位
# =======================================================


# -------- 🔴 必需 --------
# Prisma 数据源（MySQL 8+）
# 本地快速起 MySQL：docker run -d -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=yueji_beauty -p 3306:3306 mysql:8
# 然后：npx prisma db push  （首次部署）
DATABASE_URL="mysql://root:root@localhost:3306/yueji_beauty"

# JWT 签名密钥 — 务必改成随机长字符串
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-please"
JWT_EXPIRES_IN="7d"


# -------- 🔵 文件存储 --------
# 本地开发用本地目录；生产换 COS / OSS / S3（代码里 sharp 压缩 + pHash 已写好）
# 读取位置：photo/upload/route.ts, tryon/generate/route.ts
UPLOAD_DIR="./uploads"
FILE_BASE_URL="http://localhost:3000"


# -------- 🟣 AI 服务（未配置时自动返回稳定 mock，UI 正常演示）--------
# 腾讯云人脸分析（iai v20200303）
# 控制台：https://console.cloud.tencent.com/cam/capi → 创建子账号 → 加 IAI 权限
# 读取位置：lib/ai.ts, health/route.ts
TENCENTCLOUD_SECRET_ID=""
TENCENTCLOUD_SECRET_KEY=""
TENCENTCLOUD_REGION="ap-shanghai"

# 通义千问（文案生成 + AI 顾问对话）
# 控制台：https://dashscope.console.aliyun.com/apiKey → 创建 API-KEY
# 读取位置：lib/ai.ts, consultant/conversations/.../messages/route.ts
QWEN_API_KEY=""


# -------- 🟡 微信小程序 V1 静默登录 --------
# 微信公众平台：https://mp.weixin.qq.com → 开发 → 开发管理 → 开发设置
# 填 AppID + AppSecret；前端 wx.login() 拿到 code → 调本后端 /api/v1/auth/wx-login 换 token
# 读取位置：auth/wx-login/route.ts
WX_MINI_APPID=""
WX_MINI_SECRET=""


# -------- 🟠 定时任务密钥 --------
# 保护 GET /api/v1/cron/cleanup-photos 不被乱调
# 部署 Vercel 时在 Dashboard → Cron Triggers 里配每天 03:00 UTC 并带 header x-cron-secret: <这里的值>
# 本地开发可以留空（空值时不校验）
CRON_SECRET="any-random-string-for-cron"


# -------- ⚪ 前端 API 基址 --------
# uni-app 前端 request.ts 会读这个（或 fallback 到 http://localhost:3000）
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"


# -------- ⚫ 微信支付 V2 才启用（V1 全部免费，这段可以先不动）--------
# 微信商户平台：https://pay.weixin.qq.com
WECHAT_MCH_ID=""
WECHAT_APPID=""
WECHAT_API_V3_KEY=""
WECHAT_CERT_SERIAL_NO=""
# 支付回调 — 必须 HTTPS + 真实服务器域名（不能是 GitHub Pages）
WECHAT_NOTIFY_URL="https://your-domain.com/api/v1/payment/wechat/notify"
